{
  "entries": [
    {
      "id": "scroll",
      "group": "interaction",
      "description": "Scroll a list, page or document to reveal content above or below the visible area, including its beginning or end.",
      "examples": [
        "Scroll down",
        "Scorri verso il basso",
        "Reach the end of a document by scrolling",
        "Show later entries in a long list",
        "Vai alla fine del documento scorrendo",
        "Scorri per vedere altri elementi dell’elenco"
      ]
    },
    {
      "id": "click",
      "group": "interaction",
      "description": "Click or activate a visible interface control, including a button, checkbox, radio button or selectable item.",
      "examples": [
        "Click a button",
        "Premi un pulsante",
        "Turn on a checkbox",
        "Select an interface control with a mouse click",
        "Seleziona una casella di controllo",
        "Attiva un bottone dell’interfaccia"
      ]
    },
    {
      "id": "type_text",
      "group": "interaction",
      "description": "Insert text into the focused input field.",
      "examples": [
        "Type this text",
        "Scrivi questo testo"
      ]
    },
    {
      "id": "press_key",
      "group": "interaction",
      "description": "Send keyboard input: individual keys or modifier shortcuts, including Escape, Return, Tab, copy and select all.",
      "examples": [
        "Press Return",
        "Premi Invio",
        "Dismiss a dialog with Escape",
        "Use a Command keyboard combination",
        "Premi un tasto della tastiera",
        "Invia una combinazione di tasti con Comando"
      ]
    },
    {
      "id": "menu",
      "group": "interaction",
      "description": "Open an application's menu bar or choose a software command from an application menu, such as File, Edit or View.",
      "examples": [
        "Choose a menu item",
        "Scegli una voce di menu",
        "Run a command from the application menu bar",
        "Apri un menu dell’applicazione e scegli il comando"
      ]
    },
    {
      "id": "observe",
      "group": "interaction",
      "description": "Read the current window scene and its visible controls.",
      "examples": [
        "Show the current scene",
        "Mostra la scena attuale"
      ]
    },
    {
      "id": "open_session",
      "group": "interaction",
      "description": "Launch an application, editor or browser, or open a web page, and start an automation session with it.",
      "examples": [
        "Open an application",
        "Apri un’applicazione",
        "Launch an editor application",
        "Begin interacting with a website",
        "Lancia un programma di scrittura",
        "Avvia il browser per lavorare su un sito"
      ]
    },
    {
      "id": "windows",
      "group": "interaction",
      "description": "List open application windows and their titles.",
      "examples": [
        "List windows",
        "Elenca le finestre"
      ]
    },
    {
      "id": "drag",
      "group": "interaction",
      "description": "Drag and drop a visible item onto a destination: move icons, reorder cards, or pull a slider handle while holding the mouse button.",
      "examples": [
        "Drag an item",
        "Trascina un elemento",
        "Drag and drop a card onto another column",
        "Move a slider by dragging its handle",
        "Sposta un’icona trascinandola e rilasciala sulla destinazione",
        "Trascina la maniglia del cursore"
      ]
    },
    {
      "id": "screenshot",
      "group": "interaction",
      "description": "Capture a still picture of the current window and its visible interface as an image or screenshot.",
      "examples": [
        "Take a screenshot",
        "Cattura una schermata",
        "Save a picture of the visible interface",
        "Capture the window as an image",
        "Scatta una foto dell’interfaccia",
        "Salva un’istantanea della finestra"
      ]
    },
    {
      "id": "plan",
      "group": "task",
      "description": "Declare or revise the task plan and its ordered steps.",
      "examples": [
        "Plan the task steps",
        "Pianifica i passi del compito"
      ]
    },
    {
      "id": "end",
      "group": "task",
      "description": "Finish the current automation task and report its outcome.",
      "examples": [
        "Finish the task",
        "Termina il compito"
      ]
    }
