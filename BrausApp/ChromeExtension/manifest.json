{
  "manifest_version": 3,
  "name": "Braus",
  "version": "0.1.0",
  "description": "Lets Braus open, drive and close its own tabs in this Chrome profile, once you pair the profile with Braus under a name you choose. Reads no cookies or passwords.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Braus: pair this profile",
    "default_popup": "pair.html"
  },
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage",
    "tabs",
    "debugger"
  ],
  "minimum_chrome_version": "125"
}
