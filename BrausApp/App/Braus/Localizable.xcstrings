    "Confirm that this action has stopped and you have reviewed its outcome. The worker can send new actions afterward. This does not repeat the action or mark it successful.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that this action has stopped and you have reviewed its outcome. The worker can send new actions afterward. This does not repeat the action or mark it successful."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma che questa azione è terminata e che ne hai verificato l’esito. Il worker potrà quindi inviare nuove azioni. L’azione non viene ripetuta né dichiarata riuscita."
          }
        }
      }
    },
