    "Available for reuse means the action-result relationship has enough matching evidence. It does not certify a complete procedure or guarantee the next result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available for reuse means the action-result relationship has enough matching evidence. It does not certify a complete procedure or guarantee the next result."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Disponibile per il riuso” significa che il legame fra azione e risultato ha abbastanza riscontri coerenti. Non certifica una procedura completa e non garantisce il risultato successivo."
          }
        }
      }
    },
