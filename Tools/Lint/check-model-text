@dataclass
class Literal:
    start: int
    end: int
    parts: list
    raw: str


def literals(text, comments=None):
    found = []
    size = len(text)
    def code(i, depth=0):
        while i < size:
            if text.startswith('//', i):
                start = i
                end = text.find('\n', i)
                i = size if end < 0 else end
                if comments is not None:
                    comments.append((start, i))
            elif text.startswith('/*', i):
                start = i
                level = 1
                i += 2
                while i < size and level:
                    if text.startswith('/*', i): level += 1; i += 2
                    elif text.startswith('*/', i): level -= 1; i += 2
                    else: i += 1
                if level:
                    raise ValueError('Unterminated comment')
                if comments is not None:
                    comments.append((start, i))
            elif text[i] in '#"':
                start = i
                while i < size and text[i] == '#': i += 1
                hashes = text[start:i]
                if i >= size or text[i] != '"': continue
                quote = '"""' if text.startswith('"""', i) else '"'
                i += len(quote)
                content = i
                parts = []
                escape = '\\' + hashes
                while i < size:
                    if text.startswith(escape + '(', i):
                        parts.append(('text', text[content:i]))
                        expression = i + len(escape) + 1
                        i = code(expression, 1)
                        parts.append(('expression', text[expression:i-1]))
                        content = i
                    elif text.startswith(quote + hashes, i):
                        parts.append(('text', text[content:i]))
                        i += len(quote + hashes)
                        found.append(Literal(start, i, parts, text[start:i]))
                        break
                    elif text.startswith(escape, i): i += len(escape) + 1
                    else: i += 1
                else: raise ValueError('Unterminated string')
            else:
                if depth:
                    if text[i] == '(': depth += 1
                    elif text[i] == ')':
                        depth -= 1
                        if depth == 0: return i + 1
                i += 1
        if depth: raise ValueError('Unterminated interpolation')
        return i
    code(0)
    return sorted(found, key=lambda token: token.start)


def declarations(source, tokens, comments):
    masked = list(source)
    for start, end in comments + [(token.start, token.end) for token in tokens]:
        for offset in range(start, end):
            if masked[offset] != '\n':
                masked[offset] = ' '
    return list(re.finditer(r'\b(?:func|let|var)\s+([A-Za-z_][A-Za-z_0-9]*)', ''.join(masked)))


@dataclass(frozen=True)
class Finding:
    path: str
    line: int
    symbol: str
    digest: str
    raw: str

    @property
    def key(self):
        return self.path, self.symbol, self.digest


def perimeter(root):
    paths = set(CENSUS_FILES)
    for path in (root / 'Sources').rglob('*.swift'):
        relative = path.relative_to(root).as_posix()
        if relative.startswith(CATALOGUE):
            continue
        if relative.startswith('Sources/Integration/AutomationMCP/') or 'AutomationFailure(' in path.read_text():
            paths.add(relative)
    return sorted(paths)


def scan_file(path, source):
    comments = []
    tokens = literals(source, comments)
    symbols = declarations(source, tokens, comments)
    findings = []
    cursor = 0
    name = '<file>'
    for token in tokens:
        while cursor < len(symbols) and symbols[cursor].start() < token.start:
            name = symbols[cursor][1]
            cursor += 1
        findings.append(Finding(path, source.count('\n', 0, token.start) + 1,
                                name, hashlib.sha256(token.raw.encode()).hexdigest(), token.raw))
    return findings


def parse_exceptions(source):
    entries = {}
    for number, row in enumerate(source.splitlines(), 1):
        if not row.strip() or row.startswith('#'):
            continue
        fields = row.split(' | ')
        if len(fields) != 5:
            raise ValueError(f'{EXCEPTIONS}:{number}: expected path:line | symbol | hash | owner | increment')
        location, name, digest, owner, increment = fields
        path, line = location.rsplit(':', 1)
        if (not line.isdigit() or int(line) < 1 or not owner or not re.fullmatch('[A-Z]+[0-9]+', increment)
                or not re.fullmatch('[0-9a-f]{64}', digest) or '..' in Path(path).parts):
            raise ValueError(f'{EXCEPTIONS}:{number}: invalid exception')
        key = path, name, digest
        if key in entries:
            raise ValueError(f'{EXCEPTIONS}:{number}: duplicate identity')
        entries[key] = int(line), owner, increment
    return entries


def classifications():
    entries = {}
    for row in CLASSIFICATIONS.splitlines():
        if not row:
            continue
        path, name, digest, reason = row.split(' | ')
        if not reason:
            raise ValueError('Missing literal classification reason')
        entries[path, name, digest] = reason
    return entries


def check(root):
    exceptions = parse_exceptions((root / EXCEPTIONS).read_text())
    classified = classifications()
    findings = [finding for path in perimeter(root) for finding in scan_file(path, (root / path).read_text())]
    seen = {finding.key for finding in findings}
    accepted = True
    for finding in findings:
        if finding.key in exceptions:
            line, owner, increment = exceptions[finding.key]
            print(f'{finding.path}:{finding.line}: {finding.symbol} owner={owner} -> {increment} {finding.digest}')

        elif finding.key not in classified:
            print(f'{finding.path}:{finding.line}: unclassified {finding.symbol} {finding.digest}: {finding.raw}')
            accepted = False
    totals = Counter(value[1] for value in exceptions.values())
    for key, (line, _, _) in exceptions.items():
        if not any(f.key == key and f.line == line for f in findings):
            print(f'{EXCEPTIONS}: stale location {key[0]}:{line}')
            accepted = False
    for key in exceptions.keys() - seen:
        print(f'{EXCEPTIONS}: stale exception {key}')
        accepted = False
    for key in classified.keys() - seen:
        print(f'stale classification {key}')
        accepted = False
    print('exceptions=' + str(len(exceptions)) + '; ' + ', '.join(f'{k}={v}' for k, v in sorted(totals.items())))
    return 0 if accepted else 1


