"""Report every unclassified Swift literal in the model text perimeter.

Reviewed identities include the path, enclosing symbol and SHA-256 of the source
literal. Unknown literals fail closed, including single words and fragments.
"""
import argparse
from collections import Counter
from dataclasses import dataclass
import hashlib
from pathlib import Path
import re
import subprocess
import sys

EXCEPTIONS = 'Tools/Lint/model-text-exceptions.txt'
CATALOGUE = 'Sources/Integration/AutomationMCP/ModelText/'
CENSUS_FILES = (
    'Sources/Turn/SeatLine.swift',
    'BrausApp/App/Braus/Core/WorkerAgents/WorkerAgentHost.swift',
    'Sources/SeatBroker/Seat/SeatErrorMapper.swift',
    'Sources/Driver/SeatSession/Seat/RemoteContentActuation.swift',
