{
  "manifest_version": 3,
  "name": "Braus profile probe (test fixture)",
  "version": "0.1.0",
  "description": "Test fixture only: pairs this Chrome profile with a Braus probe run when the person confirms it, then opens, reads and closes local test pages only when asked by that run.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "minimum_chrome_version": "120"
}
